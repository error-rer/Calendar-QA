{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "migrate:local": "wrangler d1 migrations apply calendar-qa-db --local",
    "migrate:remote": "wrangler d1 migrations apply calendar-qa-db --remote",
    "docs": "node scripts/build-docs.mjs",
    "docs:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "test": "node tests/audit-type.test.mjs && node tests/audit-results.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260706.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "marked": "^18.3.0",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wrangler": "^4.107.0"
  }
}
